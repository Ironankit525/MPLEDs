# Copy to .env for local development only. On Vercel, add the same names in
# Project Settings -> Environment Variables; never commit real values.

# Required: persistent MongoDB database and a freshly generated JWT secret.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/mplads?retryWrites=true&w=majority
JWT_SECRET_KEY=replace-with-at-least-64-random-hex-characters

# Required on Vercel: uploaded evidence must outlive a stateless Function.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: enables generated stakeholder summaries and report chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Mandatory visual verification. These values document the required posture;
# do not disable or bypass the model in a production environment.
ENABLE_SCREEN_MODEL=True
ALLOW_VISUAL_MODEL_TEST_BYPASS=False
ENABLE_CLIP=True
